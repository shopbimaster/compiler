// 变长向量：resize 扩容保留旧数据 + 缩容
int main() {
    vector<int> v(5);
    int i = 0;
    while (i < 5) {
        v[i] = (i + 1) * 10;   // 10 20 30 40 50
        i = i + 1;
    }
    // 扩容到 8：旧 5 个保留，新增补 0
    v = vec_resize(v, 8);
    int n = vec_len(v);        // 8
    putint(n);
    putch(10);
    // 校验旧数据保留
    putint(v[0]); putch(32);   // 10
    putint(v[4]); putch(32);   // 50
    putint(v[7]); putch(10);   // 0 (新增)
    // 缩容到 3
    v = vec_resize(v, 3);
    putint(vec_len(v)); putch(10);  // 3
    putint(v[2]); putch(10);        // 30 (保留)
    return 0;
}

// 向量加法：c[i] = a[i] + b[i]
int main() {
    vector<int> a[10];
    vector<int> b[10];
    vector<int> c[10];
    int i = 0;
    while (i < 10) {
        a[i] = i;
        b[i] = i * 2;
        i = i + 1;
    }
    vec_add(a, b, c, 10);
    putarray(10, c);   // 0 3 6 9 12 15 18 21 24 27
    return 0;
}

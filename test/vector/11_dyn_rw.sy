// 变长向量：运行时长度 + 下标读写 + vec_sum
int main() {
    int n = getint();         // 运行时读入长度
    vector<int> v(n);
    int i = 0;
    while (i < n) {
        v[i] = i + 1;         // 1..n
        i = i + 1;
    }
    int s = vec_sum(v, vec_len(v));   // n(n+1)/2
    putint(s);
    putch(10);
    return 0;
}

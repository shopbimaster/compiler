// SIMD 向量乘法（逐元素）：vec a * vec b → vec c
// 预期输出: 4 6 6 4
// a = {1,2,3,4}, b = {4,3,2,1}, c = a * b = {4,6,6,4}
int main() {
    vec a = {1, 2, 3, 4};
    vec b = {4, 3, 2, 1};
    vec c = a * b;
    putint(c[0]); putch(32);
    putint(c[1]); putch(32);
    putint(c[2]); putch(32);
    putint(c[3]); putch(10);
    return 0;
}

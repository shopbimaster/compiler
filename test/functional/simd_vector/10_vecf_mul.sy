// 《前端+定长》 浮点向量扩展：vecf 乘法（FMUL，编译期展开）
// 预期输出: 2 4 6 8
// a = {1.0,2.0,3.0,4.0}, b = {2.0,2.0,2.0,2.0}, c = a * b = {2.0,4.0,6.0,8.0}
int main() {
    vecf a = {1.0, 2.0, 3.0, 4.0};
    vecf b = {2.0, 2.0, 2.0, 2.0};
    vecf c = a * b;
    putint(c[0]); putch(32);
    putint(c[1]); putch(32);
    putint(c[2]); putch(32);
    putint(c[3]); putch(10);
    return 0;
}

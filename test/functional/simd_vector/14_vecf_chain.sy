// 《前端+定长》 浮点向量扩展：vecf 链式运算（编译期展开为多次标量 FADD/FMUL）
// 预期输出: 15 18 21 24
// a = {1.0,2.0,3.0,4.0}, b = {2.0,2.0,2.0,2.0}, c = {3.0,3.0,3.0,3.0}
// d = a + b * c = a + (b*c) = {7.0,8.0,9.0,10.0}
// e = d + a = {8.0,10.0,12.0,14.0}
// f = e + d = {15.0,18.0,21.0,24.0}
int main() {
    vecf a = {1.0, 2.0, 3.0, 4.0};
    vecf b = {2.0, 2.0, 2.0, 2.0};
    vecf c = {3.0, 3.0, 3.0, 3.0};
    vecf d = a + b * c;          // = {7.0, 8.0, 9.0, 10.0}
    vecf e = d + a;              // = {8.0, 10.0, 12.0, 14.0}
    vecf f = e + d;              // = {15.0, 18.0, 21.0, 24.0}
    putint(f[0]); putch(32);
    putint(f[1]); putch(32);
    putint(f[2]); putch(32);
    putint(f[3]); putch(10);
    return 0;
}

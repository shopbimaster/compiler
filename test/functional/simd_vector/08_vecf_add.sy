// 《前端+定长》 浮点向量扩展：vecf 加法（FADD，编译期展开为 4 个标量加法）
// 预期输出: 5 6 7 8
// a = {1.0,2.0,3.0,4.0}, b = {4.0,4.0,4.0,4.0}, c = a + b = {5.0,6.0,7.0,8.0}
// putint 对 float 隐式截断，输出整数
int main() {
    vecf a = {1.0, 2.0, 3.0, 4.0};
    vecf b = {4.0, 4.0, 4.0, 4.0};
    vecf c = a + b;
    putint(c[0]); putch(32);
    putint(c[1]); putch(32);
    putint(c[2]); putch(32);
    putint(c[3]); putch(10);
    return 0;
}

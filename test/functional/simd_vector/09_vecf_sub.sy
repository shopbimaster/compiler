// 《前端+定长》 浮点向量扩展：vecf 减法（FSUB，编译期展开）
// 预期输出: 3 2 1 0
// a = {4.0,4.0,4.0,4.0}, b = {1.0,2.0,3.0,4.0}, c = a - b = {3.0,2.0,1.0,0.0}
int main() {
    vecf a = {4.0, 4.0, 4.0, 4.0};
    vecf b = {1.0, 2.0, 3.0, 4.0};
    vecf c = a - b;
    putint(c[0]); putch(32);
    putint(c[1]); putch(32);
    putint(c[2]); putch(32);
    putint(c[3]); putch(10);
    return 0;
}

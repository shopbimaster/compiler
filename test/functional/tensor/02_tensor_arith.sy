// 张量逐元素运算 + 标量广播 + 单目 ±（SysY2026）
// a = {1,2,3,4}, b = {4,3,2,1}
// a+b={5,5,5,5}  a-b={-3,-1,1,3}  a*b={4,6,6,4}  a/b={0,0,1,4}  a%b={1,2,1,0}
// a+10={11,12,13,14}  10+a={11,12,13,14}  100-a={99,98,97,96}  -a={-1,-2,-3,-4}  +a={1,2,3,4}
int main() {
    tensor int a[4] = {1, 2, 3, 4};
    tensor int b[4] = {4, 3, 2, 1};

    tensor int c1[4];
    c1 = a + b;
    putint(c1[0]); putch(32); putint(c1[1]); putch(32); putint(c1[2]); putch(32); putint(c1[3]); putch(10);

    tensor int c2[4];
    c2 = a - b;
    putint(c2[0]); putch(32); putint(c2[1]); putch(32); putint(c2[2]); putch(32); putint(c2[3]); putch(10);

    tensor int c3[4];
    c3 = a * b;
    putint(c3[0]); putch(32); putint(c3[1]); putch(32); putint(c3[2]); putch(32); putint(c3[3]); putch(10);

    tensor int c4[4];
    c4 = a / b;
    putint(c4[0]); putch(32); putint(c4[1]); putch(32); putint(c4[2]); putch(32); putint(c4[3]); putch(10);

    tensor int c5[4];
    c5 = a % b;
    putint(c5[0]); putch(32); putint(c5[1]); putch(32); putint(c5[2]); putch(32); putint(c5[3]); putch(10);

    tensor int c6[4];
    c6 = a + 10;
    putint(c6[0]); putch(32); putint(c6[1]); putch(32); putint(c6[2]); putch(32); putint(c6[3]); putch(10);

    tensor int c7[4];
    c7 = 100 - a;
    putint(c7[0]); putch(32); putint(c7[1]); putch(32); putint(c7[2]); putch(32); putint(c7[3]); putch(10);

    tensor int c8[4];
    c8 = -a;
    putint(c8[0]); putch(32); putint(c8[1]); putch(32); putint(c8[2]); putch(32); putint(c8[3]); putch(10);

    tensor int c9[4];
    c9 = +a;
    putint(c9[0]); putch(32); putint(c9[1]); putch(32); putint(c9[2]); putch(32); putint(c9[3]); putch(10);

    return 0;
}

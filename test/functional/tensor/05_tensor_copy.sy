// 张量拷贝赋值 t1 = t2（SysY2026 拷贝赋值）
int main() {
    tensor int a[4] = {1, 2, 3, 4};
    tensor int b[4] = {10, 20, 30, 40};

    // 拷贝赋值：a = b（a 被 b 的内容覆盖）
    a = b;
    putint(a[0]); putch(32); putint(a[1]); putch(32); putint(a[2]); putch(32); putint(a[3]); putch(10);

    // 拷贝后再运算，确认是深拷贝（改 a 不影响 b）
    a[0] = 99;
    putint(b[0]); putch(10);

    // 2D 拷贝
    tensor int m1[2][2] = {{1,2},{3,4}};
    tensor int m2[2][2];
    m2 = m1;
    putint(m2[0][0]); putch(32); putint(m2[0][1]); putch(32);
    putint(m2[1][0]); putch(32); putint(m2[1][1]); putch(10);

    return 0;
}

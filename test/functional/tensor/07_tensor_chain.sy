// SysY2026 链式张量运算测试：a + b + c（临时结果继续参与运算）
int main() {
    tensor int a[3] = {1, 2, 3};
    tensor int b[3] = {10, 20, 30};
    tensor int c[3] = {100, 200, 300};

    // 链式：a + b + c（左结合，先算 a+b 得临时张量，再与 c 相加）
    tensor int r[3];
    r = a + b + c;
    putint(r[0]); putch(32); putint(r[1]); putch(32); putint(r[2]); putch(10);

    // 链式 + 标量：a + b + 5
    r = a + b + 5;
    putint(r[0]); putch(32); putint(r[1]); putch(32); putint(r[2]); putch(10);

    // 链式 + 单目：-a + b
    r = -a + b;
    putint(r[0]); putch(32); putint(r[1]); putch(32); putint(r[2]); putch(10);

    // 链式 + 矩阵乘（2D）
    tensor int m1[2][2] = {{1,2},{3,4}};
    tensor int m2[2][2] = {{5,6},{7,8}};
    tensor int m3[2][2];
    // (m1 + m2) @ m2 = {{6,8},{10,12}} @ {{5,6},{7,8}}
    // = {{6*5+8*7, 6*6+8*8}, {10*5+12*7, 10*6+12*8}}
    // = {{86, 100}, {134, 156}}
    m3 = (m1 + m2) @ m2;
    putint(m3[0][0]); putch(32); putint(m3[0][1]); putch(32);
    putint(m3[1][0]); putch(32); putint(m3[1][1]); putch(10);

    return 0;
}

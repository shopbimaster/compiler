// 张量矩阵乘法 @（SysY2026）
// a = {{1,2},{3,4}}  b = {{5,6},{7,8}}
// a @ b = {{1*5+2*7, 1*6+2*8}, {3*5+4*7, 3*6+4*8}} = {{19,22},{43,50}}
int main() {
    tensor int a[2][2] = {{1,2},{3,4}};
    tensor int b[2][2] = {{5,6},{7,8}};

    tensor int c[2][2];
    c = a @ b;
    putint(c[0][0]); putch(32); putint(c[0][1]); putch(32);
    putint(c[1][0]); putch(32); putint(c[1][1]); putch(10);

    return 0;
}

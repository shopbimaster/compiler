// 《前端+显式长度》 浮点向量扩展：vecf4 部分初始化（列表元素数 < 长度，剩余零初始化）
// 预期输出: 1 2 0 0
// vecf4 a = {1.0, 2.0}; → a[0]=1.0, a[1]=2.0, a[2]=0.0, a[3]=0.0
int main() {
    vecf4 a = {1.0, 2.0};
    putint(a[0]); putch(32);
    putint(a[1]); putch(32);
    putint(a[2]); putch(32);
    putint(a[3]); putch(10);
    return 0;
}

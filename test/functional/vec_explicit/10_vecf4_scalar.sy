// 《前端+显式长度》 浮点向量扩展：vecf4 标量广播（FADD/FSUB/FMUL/FDIV，编译期展开）
// 预期输出:
//   2 4 6 8        (a * 2.0)
//   4 5 6 7        (3.0 + a)
//   10 20 30 40    (a * 10.0)
//   0 -1 -2 -3     (1.0 - a)
//   1 2 3 4        (a / 2.0，2.0/4.0/6.0/8.0 整除截断）
// a = {1.0,2.0,3.0,4.0}，除法用 2*a 测试以避免 0.5 截断
int main() {
    vecf4 a = {1.0, 2.0, 3.0, 4.0};
    vecf4 b = a * 2.0;
    vecf4 c = 3.0 + a;
    vecf4 d = a * 10.0;
    vecf4 e = 1.0 - a;
    vecf4 g = {2.0, 4.0, 6.0, 8.0};
    vecf4 f = g / 2.0;
    putint(b[0]); putch(32); putint(b[1]); putch(32); putint(b[2]); putch(32); putint(b[3]); putch(10);
    putint(c[0]); putch(32); putint(c[1]); putch(32); putint(c[2]); putch(32); putint(c[3]); putch(10);
    putint(d[0]); putch(32); putint(d[1]); putch(32); putint(d[2]); putch(32); putint(d[3]); putch(10);
    putint(e[0]); putch(32); putint(e[1]); putch(32); putint(e[2]); putch(32); putint(e[3]); putch(10);
    putint(f[0]); putch(32); putint(f[1]); putch(32); putint(f[2]); putch(32); putint(f[3]); putch(10);
    return 0;
}

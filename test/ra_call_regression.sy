// Regression test for RA-CALL-1: call-aware register preference
// Verifies that the compiler correctly handles:
// 1. Call-local values (dead before recursive calls)
// 2. Values live across recursive calls
// 3. Mixed integer operations with function calls

int fib_with_temp(int n) {
    if (n <= 1)
        return n;

    // temp1 is call-local: dead before the recursive calls
    int temp1 = n - 1 + n;

    // n, temp1, a, b must survive the first recursive call
    int a = fib_with_temp(n - 1);

    // a must survive the second recursive call
    int b = fib_with_temp(n - 2);

    // temp2 is call-local: dead before the function returns
    int temp2 = a + b + temp1;
    return temp2 - n;
}

int main() {
    int r0 = fib_with_temp(0);
    int r1 = fib_with_temp(1);
    int r5 = fib_with_temp(5);

    putint(r0);   // 0
    putch(10);
    putint(r1);   // 1
    putch(10);
    putint(r5);   // expected: computed value
    putch(10);

    return 0;
}

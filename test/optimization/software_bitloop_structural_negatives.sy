int divide_before_remainder(int left, int right) {
    int left_bit;
    int right_bit;
    int length = 32;
    int result = 0;
    int power = 1;
    while (length) {
        left = left / 2;
        left_bit = left % 2;
        right_bit = right % 2;
        right = right / 2;
        if (left_bit != right_bit) {
            result = result + power;
        }
        power = power * 2;
        length = length - 1;
    }
    return result;
}

int overwritten_length(int left, int right) {
    int left_bit;
    int right_bit;
    int length = 32;
    length = 1;
    int result = 0;
    int power = 1;
    while (length) {
        left_bit = left % 2;
        right_bit = right % 2;
        left = left / 2;
        right = right / 2;
        if (left_bit != right_bit) {
            result = result + power;
        }
        power = power * 2;
        length = length - 1;
    }
    return result;
}

int early_return(int left, int right) {
    int left_bit;
    int right_bit;
    int length = 32;
    int result = 0;
    int power = 1;
    if (left == 0) {
        return 7;
    }
    while (length) {
        left_bit = left % 2;
        right_bit = right % 2;
        left = left / 2;
        right = right / 2;
        if (left_bit != right_bit) {
            result = result + power;
        }
        power = power * 2;
        length = length - 1;
    }
    return result;
}

int both_branches_update(int left, int right) {
    int left_bit;
    int right_bit;
    int length = 32;
    int result = 0;
    int power = 1;
    while (length) {
        left_bit = left % 2;
        right_bit = right % 2;
        left = left / 2;
        right = right / 2;
        if (left_bit != right_bit) {
            result = result + power;
        } else {
            result = result + power;
        }
        power = power * 2;
        length = length - 1;
    }
    return result;
}

int main() {
    return divide_before_remainder(5, 3) +
           overwritten_length(5, 3) +
           early_return(5, 3) +
           both_branches_update(5, 3);
}

int seed;

int recur(int depth, int value) {
    if (depth == 0) {
        return seed + value;
    }
    int left = recur(depth - 1, value);
    int right = recur(depth - 1, value);
    return left + right;
}

int main() {
    int iteration = 1;
    while (iteration <= 3) {
        seed = iteration;
        putint(recur(8, 0));
        putch(10);
        iteration = iteration + 1;
    }
    return 0;
}

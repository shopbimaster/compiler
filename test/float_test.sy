// 测试float类型的基本功能
int main() {
    float a = 1.5;
    float b = 2.5;
    float c = a + b;
    int d = 10;
    float e = d + c;  // 测试隐式类型转换
    putfloat(e);
    putch(10);
    return 0;
}

// 测试浮点数组
float sum_array(float arr[], int n) {
    float sum = 0.0;
    int i = 0;
    while (i < n) {
        sum = sum + arr[i];
        i = i + 1;
    }
    return sum;
}

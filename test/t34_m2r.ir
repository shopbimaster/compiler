@arr = global [6 x i32]
declare i32 @getint()

declare i32 @getch()

declare i32 @getarray(i32* %arg0)

declare float @getfloat()

declare i32 @getfarray(float* %arg0)

declare void @putint(i32 %arg0)

declare void @putch(i32 %arg0)

declare void @putarray(i32 %arg0, i32* %arg1)

declare void @putfloat(float %arg0)

declare void @putfarray(i32 %arg0, float* %arg1)

declare void @_sysy_starttime(i32 %arg0)

declare void @_sysy_stoptime(i32 %arg0)

define i32 @main() {
entry:
  br label %while_cond_0
while_cond_0:
  %%i.phi.while_cond_0 = phi i32 [ 0, %entry ], [ %t7, %while_body_1 ]
  %%sum.phi.while_cond_0 = phi i32 [ 0, %entry ], [ %t5, %while_body_1 ]
  br i1 %, label %while_body_1, label %while_end_2
while_body_1:
  %t3 = getelementptr i32* %arr, 0, %%i.phi.while_cond_0
  %t4 = load i32, i32* %t3
  %t5 = add i32 %%sum.phi.while_cond_0, %t4
  %t7 = add i32 %%i.phi.while_cond_0, 1
  br label %while_cond_0
while_end_2:
  ret i32 %%sum.phi.while_cond_0
}


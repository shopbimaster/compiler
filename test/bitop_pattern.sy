int main() {
    // 模式1: 连续移位融合 (x>>2)>>3 → x>>5
    int a = 128;
    int b = a >> 2 >> 3;

    // 模式2: 连续AND融合 (x & 0xFF) & 0x0F → x & 0x0F
    int c = 42;
    int d = c & 255 & 15;

    // 模式5: 连续XOR常量合并 (x ^ 1) ^ 2 → x ^ 3
    int e = 10;
    int f = e ^ 1 ^ 2;

    // 模式5: 连续OR常量合并 (x | 1) | 2 → x | 3
    int g = 0;
    int h = g | 1 | 2;

    return b + d + f + h;
}
const int WIDTH = 8;

int coefficient[WIDTH][WIDTH];
int carrier[WIDTH][WIDTH];
int temporary[WIDTH][WIDTH];

void affine_step(
    int size,
    int scale[][WIDTH],
    int input[][WIDTH],
    int output[][WIDTH]) {
    int i = 0;
    while (size > i) {
        int j = 0;
        while (size > j) {
            output[i][j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }

    int k = 0;
    while (size > k) {
        i = 0;
        while (size > i) {
            int j = 0;
            while (size > j) {
                output[i][j] =
                    output[i][j] * scale[i][k] + input[k][j];
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

int main() {
    int size = getint();
    int i = 0;
    while (size > i) {
        int j = 0;
        while (size > j) {
            coefficient[i][j] = (i + j) % 3 + 2;
            carrier[i][j] = i * size + j + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    int round = 0;
    while (round < 2) {
        affine_step(
            size, coefficient, carrier, temporary);
        affine_step(
            size, coefficient, temporary, carrier);
        round = round + 1;
    }

    int result = 0;
    i = 0;
    while (size > i) {
        int j = 0;
        while (size > j) {
            result = result + carrier[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(result);
    putch(10);
    return 0;
}

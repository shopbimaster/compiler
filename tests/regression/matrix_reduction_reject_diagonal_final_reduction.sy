const int WIDTH = 4;

int coefficient[WIDTH][WIDTH];
int carrier[WIDTH][WIDTH];
int temporary[WIDTH][WIDTH];

void affine_step(
    int size,
    int scale[][WIDTH],
    int input[][WIDTH],
    int output[][WIDTH]) {
    int i = 0;
    while (i < size) {
        int j = 0;
        while (j < size) {
            output[i][j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }

    int k = 0;
    while (k < size) {
        i = 0;
        while (i < size) {
            int j = 0;
            while (j < size) {
                output[i][j] =
                    output[i][j] * scale[i][k] + input[k][j];
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

int main() {
    int size = getint();
    int rounds = getint();
    int i = 0;
    while (i < size) {
        int j = 0;
        while (j < size) {
            coefficient[i][j] = 2;
            carrier[i][j] = i * size + j + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    int round = 0;
    while (round < rounds) {
        affine_step(size, coefficient, carrier, temporary);
        round = round + 1;
    }

    int result = 0;
    i = 0;
    while (i < size) {
        result = result + temporary[i][i];
        i = i + 1;
    }
    putint(result);
    putch(10);
    return 0;
}

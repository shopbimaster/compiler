const int WIDTH = 8;

int coefficient[WIDTH][WIDTH];
int carrier[WIDTH][WIDTH];
int temporary[WIDTH][WIDTH];

void affine_step(
    int size,
    int scale[][WIDTH],
    int input[][WIDTH],
    int output[][WIDTH],
    int fill) {
    if (fill < 0) {
        return;
    }

    int i = 0;
    while (i < size) {
        int j = 0;
        while (j < size) {
            output[i][j] = fill;
            j = j + 1;
        }
        i = i + 1;
    }

    int k = 0;
    while (k < size) {
        i = 0;
        while (i < size) {
            if (scale[i][k] == 1) {
                i = i + 1;
                continue;
            }
            int j = 0;
            while (j < size) {
                output[i][j] =
                    output[i][j] * scale[i][k] + input[k][j];
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

int main() {
    int size = getint();
    int fill = getint();
    int i = 0;
    while (i < size) {
        int j = 0;
        while (j < size) {
            coefficient[i][j] = (i + j) % 3 + 1;
            carrier[i][j] = i * size + j + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    int round = 0;
    while (round < 2) {
        affine_step(
            size, coefficient, carrier, temporary, fill);
        affine_step(
            size, coefficient, temporary, carrier, fill);
        round = round + 1;
    }

    int result = 0;
    i = 0;
    while (i < size) {
        int j = 0;
        while (j < size) {
            result = result + carrier[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(result);
    putch(10);
    return 0;
}

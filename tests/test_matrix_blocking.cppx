#include "ir/IRBuilder.h"
#include "opt/MemoryAccessAnalysis.h"
#include "opt/Optimizer.h"

#include <cstdlib>
#include <iostream>
#include <string>

namespace {

struct OptimizationResult {
    std::string ir;
    bool changed = false;
    bool inPlaceHelperPrefersExpandedRegisters = false;
    bool conditionalHelperPrefersExpandedRegisters = false;
    bool anyFunctionPrefersExpandedRegisters = false;
    bool writesDeadY = false;
    bool callsHotLeafF = false;
    bool callsHotLoopTest = false;
};

bool hasMatrixReductionHelpers(const OptimizationResult& result) {
    return result.ir.find("__opt_contract_row_sum") != std::string::npos ||
        result.ir.find("__opt_affine_row_summary") != std::string::npos ||
        result.ir.find("__opt_reduction_summary_total") != std::string::npos;
}

bool hasCompleteMatrixReductionHelpers(const OptimizationResult& result) {
    return result.ir.find("__opt_contract_row_sum") != std::string::npos &&
        result.ir.find("__opt_affine_row_summary") != std::string::npos &&
        result.ir.find("__opt_reduction_summary_total") != std::string::npos;
}

OptimizationResult runFocusedPass(
        const std::string& source, bool (*pass)(IR::Module*)) {
    IR::IRBuilder builder;
    auto module = builder.compile(source);
    Opt::runO1(module.get());
    OptimizationResult result;
    result.changed = pass(module.get());
    result.ir = module->dump();
    return result;
}

OptimizationResult optimizeToO2(const std::string& source) {
    IR::IRBuilder builder;
    auto module = builder.compile(source);
    Opt::runO1(module.get());
    Opt::runO2(module.get());
    OptimizationResult result;
    result.ir = module->dump();
    for (const auto& function : module->getFunctions()) {
        for (const auto& block : function->getBlocks()) {
            for (const auto& instruction : block->getInstructions()) {
                if (instruction->getOpcode() ==
                        IR::Instruction::Opcode::CALL &&
                    instruction->getNumOperands() != 0) {
                    const auto& callee = instruction->getOperand(0)->getName();
                    result.callsHotLeafF |= callee == "f";
                    result.callsHotLoopTest |= callee == "loop_test";
                }
                if (instruction->getOpcode() !=
                        IR::Instruction::Opcode::STORE ||
                    instruction->getNumOperands() != 2) {
                    continue;
                }
                auto* global = Opt::rootGlobal(instruction->getOperand(1));
                if (global && global->getName() == "y") {
                    result.writesDeadY = true;
                }
            }
        }
        if (!function->prefersExpandedLeafRegisters()) continue;
        result.anyFunctionPrefersExpandedRegisters = true;
        if (function->getName() == "__opt_inplace_matrix_row_private") {
            result.inPlaceHelperPrefersExpandedRegisters = true;
        }
        if (function->getName() == "__opt_conditional_matrix_mask4") {
            result.conditionalHelperPrefersExpandedRegisters = true;
        }
    }
    return result;
}

} // namespace

int main() {
#ifdef _WIN32
    _putenv_s("M2R_NONENTRY_ALLPASS", "1");
#else
    setenv("M2R_NONENTRY_ALLPASS", "1", 1);
#endif

    const OptimizationResult constantFillReduction = optimizeToO2(
        "../tests/regression/matrix_reduction_constant_fill.sy");
    if (!hasCompleteMatrixReductionHelpers(constantFillReduction)) {
        std::cerr << "valid constant-fill matrix reduction did not trigger\n";
        return 1;
    }

    const OptimizationResult guardedReduction = optimizeToO2(
        "../tests/regression/matrix_reduction_guarded_update.sy");
    if (!hasCompleteMatrixReductionHelpers(guardedReduction)) {
        std::cerr << "valid guarded matrix reduction did not trigger\n";
        return 1;
    }

    const OptimizationResult dynamicFillReduction = optimizeToO2(
        "../tests/regression/matrix_reduction_dynamic_fill.sy");
    if (!hasCompleteMatrixReductionHelpers(dynamicFillReduction)) {
        std::cerr << "valid dynamic-fill matrix reduction did not trigger\n";
        return 1;
    }

    const OptimizationResult reorderedArgumentsReduction = optimizeToO2(
        "../tests/regression/matrix_reduction_reordered_args.sy");
    if (!hasCompleteMatrixReductionHelpers(reorderedArgumentsReduction)) {
        std::cerr << "valid reordered-argument matrix reduction did not trigger\n";
        return 1;
    }

    struct RejectedMatrixReductionFixture {
        const char* source;
        const char* description;
    };
    const RejectedMatrixReductionFixture rejectedReductions[] = {
        {"../tests/regression/matrix_reduction_reject_diagonal_init.sy",
         "diagonal-only initialization"},
        {"../tests/regression/matrix_reduction_reject_conditional_init.sy",
         "conditional initialization"},
        {"../tests/regression/matrix_reduction_reject_late_init.sy",
         "initialization after the recurrence"},
        {"../tests/regression/matrix_reduction_reject_kernel_early_return.sy",
         "coefficient guard that returns from the kernel"},
        {"../tests/regression/matrix_reduction_reject_kernel_return_before_recurrence.sy",
         "kernel return between initialization and recurrence"},
        {"../tests/regression/matrix_reduction_reject_kernel_extra_loop.sy",
         "additional possibly nonterminating kernel loop"},
        {"../tests/regression/matrix_reduction_reject_diagonal_final_reduction.sy",
         "diagonal-only final reduction"},
        {"../tests/regression/matrix_reduction_reject_conditional_final_reduction.sy",
         "conditional final reduction"},
        {"../tests/regression/matrix_reduction_reject_accumulator_extra_read.sy",
         "extra accumulator read controlling an early return"},
        {"../tests/regression/matrix_reduction_reject_submatrix_slice.sy",
         "submatrix input slice"},
        {"../tests/regression/matrix_reduction_reject_zero_slice.sy",
         "zero-offset slice of a three-dimensional global"},
        {"../tests/regression/matrix_reduction_reject_const_seed.sy",
         "read-only matrix used as the summary seed"},
        {"../tests/regression/matrix_reduction_reject_reduction_extra_loop.sy",
         "additional possibly nonterminating final-reduction loop"},
        {"../tests/regression/matrix_reduction_reject_call_loop_extra_loop.sy",
         "possibly nonterminating loop before the kernel call"},
        {"../tests/regression/matrix_reduction_reject_zero_trip_call_loop.sy",
         "possibly zero-trip call loop with a distinct result matrix"},
    };
    for (const auto& fixture : rejectedReductions) {
        const OptimizationResult result = optimizeToO2(fixture.source);
        if (hasMatrixReductionHelpers(result)) {
            std::cerr << "unsafe matrix reduction triggered for "
                      << fixture.description << "\n";
            return 1;
        }
    }

    const OptimizationResult inPlace = optimizeToO2(
        "../test/performance/many_mat_cal-1.sy");
    if (inPlace.ir.find("__opt_inplace_matrix_row_private") ==
        std::string::npos) {
        std::cerr << "in-place matrix reduction was not row-privatized\n";
        return 1;
    }
    if (!inPlace.inPlaceHelperPrefersExpandedRegisters) {
        std::cerr << "row-private helper is missing its leaf-register hint\n";
        return 1;
    }

    const OptimizationResult renamedInPlace = optimizeToO2(
        "../test/optimization/inplace_matrix_row_private_variant.sy");
    if (renamedInPlace.ir.find("__opt_inplace_matrix_row_private") ==
        std::string::npos) {
        std::cerr << "renamed in-place matrix reduction did not trigger\n";
        return 1;
    }
    if (inPlace.ir.find("__opt_conditional_matrix_mask4") !=
        std::string::npos) {
        std::cerr << "in-place kernel triggered conditional blocking\n";
        return 1;
    }

    const OptimizationResult conditional = optimizeToO2(
        "../test/performance/matmul1.sy");
    if (conditional.ir.find("__opt_inplace_matrix_row_private") !=
        std::string::npos) {
        std::cerr << "out-of-place matrix kernel triggered in-place blocking\n";
        return 1;
    }
    if (conditional.ir.find("__opt_conditional_matrix_mask4") ==
        std::string::npos) {
        std::cerr << "conditional matrix reduction did not trigger blocking\n";
        return 1;
    }
    if (!conditional.conditionalHelperPrefersExpandedRegisters) {
        std::cerr << "conditional helper is missing its leaf-register hint\n";
        return 1;
    }
    const auto firstProduct = conditional.ir.find("%block.product.0 =");
    const auto firstMaskLoad = conditional.ir.find("%block.B.0 = load");
    if (firstProduct == std::string::npos ||
        firstMaskLoad == std::string::npos ||
        firstProduct > firstMaskLoad) {
        std::cerr << "conditional lane product was sunk across its mask chain\n";
        return 1;
    }

    const OptimizationResult negative = optimizeToO2(
        "../test/performance/conv2d-1.sy");
    if (negative.ir.find("__opt_inplace_matrix_row_private") !=
            std::string::npos ||
        negative.ir.find("__opt_conditional_matrix_mask4") !=
            std::string::npos) {
        std::cerr << "unrelated matrix kernel triggered blocking\n";
        return 1;
    }
    if (negative.anyFunctionPrefersExpandedRegisters) {
        std::cerr << "leaf-register hint escaped the blocked helper\n";
        return 1;
    }

    const OptimizationResult triangular = optimizeToO2(
        "../test/performance/transpose0.sy");
    if (triangular.ir.find("triangular.limit") == std::string::npos) {
        std::cerr << "triangular copy did not restrict its inner loop\n";
        return 1;
    }

    const OptimizationResult deadGlobal = optimizeToO2(
        "../test/performance/sl1.sy");
    if (deadGlobal.writesDeadY) {
        std::cerr << "write-only global array stores were not eliminated\n";
        return 1;
    }

    const OptimizationResult hotInline = optimizeToO2(
        "../test/performance/h-4-01.sy");
    if (hotInline.callsHotLeafF || hotInline.callsHotLoopTest) {
        std::cerr << "unique hot-loop leaf calls were not inlined\n";
        return 1;
    }

    const OptimizationResult genericRepeat = runFocusedPass(
        "../test/optimization/redundant_iteration_variant.sy",
        Opt::redundantIterationElimination);
    if (!genericRepeat.changed) {
        std::cerr << "renamed redundant-iteration variant did not trigger\n";
        return 1;
    }

    const OptimizationResult genericFixedPoint = runFocusedPass(
        "../test/optimization/dynamic_fixed_point_variant.sy",
        Opt::dynamicIdempotentLoopElimination);
    if (!genericFixedPoint.changed ||
        genericFixedPoint.ir.find("fixedpoint.ready") == std::string::npos) {
        std::cerr << "renamed dynamic fixed-point variant did not trigger\n";
        return 1;
    }

    IR::Module effectsModule;
    auto* i32 = IR::IntegerType::I32;
    auto* tracked = effectsModule.createGlobalVariable(
        IR::PointerType::get(i32), "tracked", false,
        IR::ConstantInt::get(i32, 0));
    auto* observer = effectsModule.createFunction(
        IR::FunctionType::get(
            IR::VoidType::get(), {tracked->getType()}),
        "observe", true);
    auto* effectsFunction = effectsModule.createFunction(
        IR::FunctionType::get(IR::VoidType::get(), {}),
        "effects");
    auto* effectsEntry = effectsFunction->createBlock("entry");
    effectsEntry->pushBack(
        IR::Instruction::createLoad(i32, tracked, "loaded"));
    effectsEntry->pushBack(IR::Instruction::createStore(
        IR::ConstantInt::get(i32, 1), tracked));
    effectsEntry->pushBack(IR::Instruction::createCall(
        observer->getFunctionType(), observer, {tracked}, ""));
    effectsEntry->pushBack(IR::Instruction::createRet(nullptr));

    Opt::GlobalMemoryEffects effects;
    if (!Opt::analyzeGlobalMemoryEffects(tracked, effects) ||
        effects.loads.size() != 1 ||
        effects.stores.size() != 1 ||
        effects.calls.size() != 1) {
        std::cerr << "global memory effects were not classified precisely\n";
        return 1;
    }

    IR::Module escapeModule;
    auto* escaped = escapeModule.createGlobalVariable(
        IR::PointerType::get(i32), "escaped", false,
        IR::ConstantInt::get(i32, 0));
    auto* escapeFunction = escapeModule.createFunction(
        IR::FunctionType::get(IR::VoidType::get(), {}),
        "escape");
    auto* escapeEntry = escapeFunction->createBlock("entry");
    auto* pointerSlot = IR::Instruction::createAlloca(
        escaped->getType(), "pointer.slot");
    escapeEntry->pushBack(pointerSlot);
    escapeEntry->pushBack(
        IR::Instruction::createStore(escaped, pointerSlot));
    escapeEntry->pushBack(IR::Instruction::createRet(nullptr));
    Opt::GlobalMemoryEffects escapedEffects;
    if (Opt::analyzeGlobalMemoryEffects(
            escaped, escapedEffects)) {
        std::cerr << "stored global address was not treated as an escape\n";
        return 1;
    }

    std::cout << "Optimization trigger checks passed\n";
    return 0;
}

#include "ir/IRBuilder.h"
#include "opt/Optimizer.h"

#include <iostream>
#include <string>

namespace {

struct OptimizationResult {
    std::string ir;
    bool helperPrefersExpandedRegisters = false;
    bool anyFunctionPrefersExpandedRegisters = false;
};

OptimizationResult optimizeToO2(const std::string& source) {
    IR::IRBuilder builder;
    auto module = builder.compile(source);
    Opt::runO1(module.get());
    Opt::runO2(module.get());
    OptimizationResult result;
    result.ir = module->dump();
    for (const auto& function : module->getFunctions()) {
        if (!function->prefersExpandedLeafRegisters()) continue;
        result.anyFunctionPrefersExpandedRegisters = true;
        if (function->getName() == "__opt_inplace_matrix_block4") {
            result.helperPrefersExpandedRegisters = true;
        }
    }
    return result;
}

} // namespace

int main() {
    const OptimizationResult inPlace = optimizeToO2(
        "../test/performance/many_mat_cal-1.sy");
    if (inPlace.ir.find("__opt_inplace_matrix_block4") ==
        std::string::npos) {
        std::cerr << "in-place matrix reduction did not trigger blocking\n";
        return 1;
    }
    if (!inPlace.helperPrefersExpandedRegisters) {
        std::cerr << "blocked helper is missing its leaf-register hint\n";
        return 1;
    }

    const OptimizationResult outOfPlace = optimizeToO2(
        "../test/performance/matmul1.sy");
    if (outOfPlace.ir.find("__opt_inplace_matrix_block4") !=
        std::string::npos) {
        std::cerr << "out-of-place matrix kernel triggered in-place blocking\n";
        return 1;
    }
    if (outOfPlace.anyFunctionPrefersExpandedRegisters) {
        std::cerr << "leaf-register hint escaped the blocked helper\n";
        return 1;
    }

    std::cout << "In-place matrix blocking trigger checks passed\n";
    return 0;
}

#include "opt/Optimizer.h"

#include <iostream>
#include <string>

namespace {

bool expectContains(const std::string& text, const std::string& needle,
                    const char* message) {
    if (text.find(needle) != std::string::npos) return true;
    std::cerr << "FAILED: " << message << '\n';
    return false;
}

bool expectNotContains(const std::string& text, const std::string& needle,
                       const char* message) {
    if (text.find(needle) == std::string::npos) return true;
    std::cerr << "FAILED: " << message << '\n';
    return false;
}

} // namespace

int main() {
    bool passed = true;

    const std::string floatLoad =
        "  la t0, global_float\n"
        "  flw ft0, 0(t0)\n"
        "  li t0, 0\n"
        "  ret\n";
    const std::string floatResult = Opt::peepholeOptimize(floatLoad);
    passed &= expectContains(floatResult, "la t0, global_float",
                             "flw symbolic load lost its address register");
    passed &= expectContains(floatResult, "flw ft0, 0(t0)",
                             "flw symbolic load was rewritten");

    const std::string doubleLoad =
        "  la t0, global_double\n"
        "  fld ft1, 8(t0)\n"
        "  li t0, 0\n"
        "  ret\n";
    const std::string doubleResult = Opt::peepholeOptimize(doubleLoad);
    passed &= expectContains(doubleResult, "la t0, global_double",
                             "fld symbolic load lost its address register");
    passed &= expectContains(doubleResult, "fld ft1, 8(t0)",
                             "fld symbolic load was rewritten");

    const std::string integerLoad =
        "  la t0, global_int\n"
        "  lw t1, 0(t0)\n"
        "  li t0, 0\n"
        "  ret\n";
    const std::string integerResult = Opt::peepholeOptimize(integerLoad);
    passed &= expectNotContains(integerResult, "la t0, global_int",
                                "integer symbolic load stopped folding");
    passed &= expectContains(integerResult, "lw", "folded lw is missing");
    passed &= expectContains(integerResult, "global_int",
                             "folded lw lost its symbol");

    const std::string privateIntegerSpill =
        "entry:\n"
        "  sw t0, 40(sp)\n"
        "  lw t0, 40(sp)\n"
        "  addw t1, t0, t2\n"
        "  ret\n";
    const std::string privateIntegerResult =
        Opt::peepholeOptimize(privateIntegerSpill);
    passed &= expectNotContains(privateIntegerResult, "40(sp)",
                                "private integer spill round trip remained");

    const std::string privatePointerSpill =
        "entry:\n"
        "  sd t0, 48(sp)\n"
        "  ld t1, 48(sp)\n"
        "  lw t2, 0(t1)\n"
        "  ret\n";
    const std::string privatePointerResult =
        Opt::peepholeOptimize(privatePointerSpill);
    passed &= expectNotContains(privatePointerResult, "48(sp)",
                                "private pointer spill round trip remained");
    passed &= expectContains(privatePointerResult, "mv      t1, t0",
                             "private pointer reload was not forwarded");

    const std::string sharedSpill =
        "entry:\n"
        "  sw t0, 56(sp)\n"
        "  lw t0, 56(sp)\n"
        "  addw t1, t0, t2\n"
        "  addw t4, t3, t5\n"
        "  li t0, 0\n"
        "  lw t3, 56(sp)\n"
        "  addw a0, t1, t3\n"
        "  ret\n";
    const std::string sharedSpillResult = Opt::peepholeOptimize(sharedSpill);
    passed &= expectContains(sharedSpillResult, "sw t0, 56(sp)",
                             "shared spill store was incorrectly removed");

    const std::string escapedSlot =
        "entry:\n"
        "  sw t0, 64(sp)\n"
        "  lw t0, 64(sp)\n"
        "  addi a0, sp, 64\n"
        "  call consume\n"
        "  ret\n";
    const std::string escapedSlotResult = Opt::peepholeOptimize(escapedSlot);
    passed &= expectContains(escapedSlotResult, "sw t0, 64(sp)",
                             "escaped stack slot store was incorrectly removed");

    const std::string nonAdjacentSurvivingSource =
        "entry:\n"
        "  sw t0, 72(sp)\n"
        "  addiw t2, t2, 1\n"
        "  lw t0, 72(sp)\n"
        "  ret\n";
    const std::string nonAdjacentSurvivingResult =
        Opt::peepholeOptimize(nonAdjacentSurvivingSource);
    passed &= expectNotContains(nonAdjacentSurvivingResult, "72(sp)",
                                "surviving spill source was not forwarded");

    const std::string earlyCaptureSpill =
        "entry:\n"
        "  sw t0, 80(sp)\n"
        "  lw t0, 0(a0)\n"
        "  addw t2, t2, t3\n"
        "  lw t1, 80(sp)\n"
        "  addw a0, t1, t2\n"
        "  ret\n";
    const std::string earlyCaptureResult =
        Opt::peepholeOptimize(earlyCaptureSpill);
    passed &= expectNotContains(earlyCaptureResult, "80(sp)",
                                "early-capture spill round trip remained");
    passed &= expectContains(earlyCaptureResult, "mv      t1, t0",
                             "spill value was not captured before clobber");

    const std::string liveDestinationSpill =
        "entry:\n"
        "  sw t0, 88(sp)\n"
        "  addw t2, t1, t3\n"
        "  lw t0, 0(a0)\n"
        "  lw t1, 88(sp)\n"
        "  addw a0, t1, t2\n"
        "  ret\n";
    const std::string liveDestinationResult =
        Opt::peepholeOptimize(liveDestinationSpill);
    passed &= expectContains(liveDestinationResult, "sw t0, 88(sp)",
                             "live reload destination was overwritten early");

    const std::string crossBlockSpill =
        "entry:\n"
        "  sw t0, 96(sp)\n"
        "next:\n"
        "  lw t0, 96(sp)\n"
        "  ret\n";
    const std::string crossBlockResult =
        Opt::peepholeOptimize(crossBlockSpill);
    passed &= expectContains(crossBlockResult, "sw t0, 96(sp)",
                             "spill was forwarded across a block boundary");

    const std::string overlappingSlot =
        "entry:\n"
        "  sd t0, 104(sp)\n"
        "  lw t1, 108(sp)\n"
        "  ld t0, 104(sp)\n"
        "  addw a0, t1, t2\n"
        "  ret\n";
    const std::string overlappingSlotResult =
        Opt::peepholeOptimize(overlappingSlot);
    passed &= expectContains(overlappingSlotResult, "sd t0, 104(sp)",
                             "overlapping stack access lost its source store");

    const std::string indirectlyEscapedSlot =
        "entry:\n"
        "  sw t0, 112(sp)\n"
        "  mv a0, sp\n"
        "  addi a0, a0, 112\n"
        "  lw t0, 112(sp)\n"
        "  ret\n";
    const std::string indirectlyEscapedResult =
        Opt::peepholeOptimize(indirectlyEscapedSlot);
    passed &= expectContains(indirectlyEscapedResult, "sw t0, 112(sp)",
                             "indirectly escaped stack slot lost its store");

    if (passed) std::cout << "Peephole floating-load regression passed\n";
    return passed ? 0 : 1;
}
